{
  "name": "backend-exam-template",
  "version": "1.0.0",
  "description": "Plantilla adaptable para prueba de desempeño Backend Node.js + TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/database/seeders/seed.ts",
